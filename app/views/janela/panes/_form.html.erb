<%
  # Step two: every option comes from this model's janela block, so a choice
  # that would be rejected is not offered in the first place.
  measures = definition.measures.keys.map { |name| [ name.to_s.humanize, name ] }
  dimensions = definition.dimensions.keys.map { |name| [ name.to_s.humanize, name ] }
  time_dimensions = definition.dimensions.values.select(&:time?).map { |dimension| dimension.name.to_s.humanize }
  chosen = definition.dimensions[pane.dimension.presence&.to_sym]
  granularity_applies = pane.dimension.present? ? chosen&.time? : time_dimensions.any?
%>
<%= form_with model: pane, url: pane.persisted? ? frame_pane_path(frame, pane) : frame_panes_path(frame), class: "janela-form" do |form| %>
  <%= render "janela/shared/errors", record: pane %>
  <%= form.hidden_field :model %>

  <p class="janela-muted"><%= Janela::Pane.human_attribute_name(:model) %>: <%= definition.model.model_name.human %></p>

  <div class="janela-field">
    <%= form.label :measure %>
    <%= form.select :measure, measures %>
  </div>

  <div class="janela-field">
    <%= form.label :dimension %>
    <%= form.select :dimension, dimensions, include_blank: t("janela.panes.no_dimension") %>
  </div>

  <div class="janela-field">
    <%= form.label :renderer %>
    <%= form.select :renderer, Janela::Query::RENDERERS.map { |renderer| [ t("janela.renderers.#{renderer}"), renderer ] } %>
  </div>

  <% if granularity_applies %>
    <div class="janela-field">
      <%= form.label :granularity %>
      <%= form.select :granularity, Janela::Dimension::GRANULARITIES.map { |value| [ value.humanize, value ] }, include_blank: t("janela.panes.declared_granularity") %>
      <span class="janela-hint"><%= t("janela.panes.granularity_hint", dimensions: time_dimensions.to_sentence) %></span>
    </div>
  <% end %>

  <div class="janela-field">
    <%= form.label :limit %>
    <%= form.select :limit, Janela::Pane::OFFERED_LIMITS, include_blank: t("janela.panes.no_limit") %>
  </div>

  <%# Blank is largest first, so desc is not offered a second time. %>
  <div class="janela-field">
    <%= form.label :sort %>
    <%= form.select :sort, (Janela.sorts - %w[desc]).map { |value| [ t("janela.sorts.#{value}"), value ] }, include_blank: t("janela.sorts.desc") %>
    <span class="janela-hint"><%= t("janela.sorts.hint") %></span>
  </div>

  <%# What may sit beside the label: this model's other measures and its
      categorical dimensions. The pane's own choices are left out when they are
      already made (ADR 051). %>
  <%
    companion_choices = {
      t("janela.companions.measures") => definition.measures.keys.reject { |name| name.to_s == pane.measure }.map { |name| [ name.to_s.humanize, name ] },
      t("janela.companions.dimensions") => definition.dimensions.values.reject { |each| each.time? || each.name.to_s == pane.dimension }.map { |each| [ each.name.to_s.humanize, each.name ] }
    }
  %>
  <div class="janela-field">
    <%= form.label :companions %>
    <%= form.select :companions, companion_choices, {}, multiple: true %>
    <span class="janela-hint"><%= t("janela.companions.hint") %></span>
  </div>

  <%# A running total and further series apply to a time pane (ADR 062). The
      series slots are plain selects, one blank beyond those the row holds, up
      to the most a pane may carry, since these pages have no JavaScript to
      add a row on demand (ADR 018). Each slot leads with its measure, which
      is how the browser's params keep one slot's fields together. %>
  <% if granularity_applies %>
    <div class="janela-field">
      <%= form.check_box :cumulative %>
      <%= form.label :cumulative %>
      <span class="janela-hint"><%= t("janela.series.cumulative_hint") %></span>
    </div>

    <%
      slots = Array(pane.series).first(Janela::Query::MAX_SERIES)
      slots << {} if slots.size < Janela::Query::MAX_SERIES
      time_choices = definition.dimensions.values.select(&:time?).map { |dimension| [ dimension.name.to_s.humanize, dimension.name ] }
    %>
    <fieldset class="janela-field janela-series">
      <legend><%= Janela::Pane.human_attribute_name(:series) %></legend>
      <span class="janela-hint"><%= t("janela.series.hint", count: Janela::Query::MAX_SERIES) %></span>
      <% slots.each_with_index do |slot, index| %>
        <% slot = slot.to_h.stringify_keys %>
        <div class="janela-series-slot">
          <%= label_tag "pane_series_#{index}_measure", t("janela.series.measure") %>
          <%= select_tag "pane[series][][measure]", options_for_select(measures, slot["measure"]), include_blank: t("janela.series.none"), id: "pane_series_#{index}_measure" %>
          <%= label_tag "pane_series_#{index}_by", t("janela.series.by") %>
          <%= select_tag "pane[series][][by]", options_for_select(time_choices, slot["by"]), include_blank: t("janela.series.same_as_pane"), id: "pane_series_#{index}_by" %>
          <%= check_box_tag "pane[series][][cumulative]", "1", ActiveModel::Type::Boolean.new.cast(slot["cumulative"]), id: "pane_series_#{index}_cumulative" %>
          <%= label_tag "pane_series_#{index}_cumulative", Janela::Pane.human_attribute_name(:cumulative) %>
          <%= label_tag "pane_series_#{index}_as", t("janela.series.as") %>
          <%= select_tag "pane[series][][as]", options_for_select(Janela::Query::CANVAS.map { |each| [ t("janela.renderers.#{each}"), each ] }, slot["as"]), include_blank: t("janela.series.same_as_pane"), id: "pane_series_#{index}_as" %>
          <%= label_tag "pane_series_#{index}_axis", t("janela.series.axis") %>
          <%= select_tag "pane[series][][axis]", options_for_select(Janela::Query::AXES.map { |each| [ t("janela.series.axes.#{each}"), each ] }, slot["axis"]), id: "pane_series_#{index}_axis" %>
          <%= label_tag "pane_series_#{index}_title", Janela::Pane.human_attribute_name(:title) %>
          <%= text_field_tag "pane[series][][title]", slot["title"], id: "pane_series_#{index}_title", placeholder: t("janela.panes.title_placeholder") %>
        </div>
      <% end %>
    </fieldset>
  <% end %>

  <div class="janela-field">
    <%= form.label :height %>
    <%= form.select :height, Janela::Pane::HEIGHTS.map { |step| [ t("janela.heights.#{step}"), step ] }, include_blank: t("janela.heights.automatic") %>
  </div>

  <div class="janela-field">
    <%= form.label :prominence %>
    <%= form.select :prominence, Janela::Pane::PROMINENCES.map { |step| [ t("janela.prominences.#{step}"), step ] }, include_blank: t("janela.prominences.automatic") %>
  </div>

  <div class="janela-field">
    <%= form.check_box :value_labels %>
    <%= form.label :value_labels %>
    <span class="janela-hint"><%= t("janela.value_labels.hint") %></span>
  </div>

  <div class="janela-field">
    <%= form.label :span %>
    <%= form.select :span, Janela::Pane::SPANS.to_a %>
  </div>

  <div class="janela-field">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: t("janela.panes.title_placeholder") %>
  </div>

  <div class="janela-actions">
    <%= form.submit t("janela.actions.save"), class: "janela-button" %>
    <%= link_to t("janela.actions.cancel"), edit_frame_path(frame) %>
  </div>
<% end %>
