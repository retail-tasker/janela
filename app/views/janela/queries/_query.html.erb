<%# One pane's content, without its turbo frame: the same markup whether the
    pane came from a URL, a row, or a frame rendered inline. %>
<% if query.single_value? %>
  <%= tag.p class: [ "janela-pane", "janela-value", ("janela-prominence-#{query.prominence}" if query.prominent?) ] do %>
    <span class="janela-value-label"><%= query.title %></span>
    <strong class="janela-value-number"><%= query.format(result || 0) %></strong>
  <% end %>
<% elsif result.empty? %>
  <p class="janela-pane janela-empty"><%= query.title %>: no data</p>
<% elsif query.ring? && query.ringable?(result) %>
  <%= render "janela/queries/ring", query: query, result: result %>
<% elsif query.chart? %>
  <% title_id = "#{query.turbo_frame_id}-title" %>
  <figure class="janela-pane">
    <figcaption class="janela-chart-title" id="<%= title_id %>"><%= query.title %></figcaption>
    <%# A height puts the canvas in a box of fixed size for the chart to fill;
        with none there is no box and the chart is what it always was (ADR 047). %>
    <% canvas = capture do %>
    <canvas class="janela-chart"
            data-controller="janela--chart"
            data-action="janela--chart:toggle->janela--frame#toggle"
            data-janela--chart-type-value="<%= query.renderer %>"
            data-janela--chart-title-value="<%= query.title %>"
            data-janela--chart-selected-value="<%= query.selected_values.to_json %>"
            data-janela--chart-labels-value="<%= result.keys.to_json %>"
            data-janela--chart-values-value="<%= result.values.map(&:to_f).to_json %>"
            data-janela--chart-formatted-value="<%= result.values.map { |measured| query.format(measured) }.to_json %>"
            data-janela--chart-filters-value="<%= query.filters_for(result.keys).to_json %>"
            <%= tag.attributes(aria: { description: (t("janela.time.click_hint") if query.time? && query.clickable?) }) %>
            <%= "data-janela--chart-fixed-height-value=true".html_safe if query.boxed? %>
            role="img" aria-labelledby="<%= title_id %>"></canvas>
    <% end %>
    <%= query.boxed? ? tag.div(canvas, class: "janela-chart-box janela-h-#{query.height}") : canvas %>
  </figure>
<% else %>
  <%= tag.table class: "janela-pane", aria: { description: (t("janela.time.click_hint") if query.time? && query.clickable?) } do %>
    <caption><%= query.title %></caption>
    <%# A header row only when there are companions to name: two columns read
        without one, and a table with none is what it always was (ADR 051). %>
    <% if query.companion_columns.any? %>
      <thead>
        <tr>
          <th scope="col"><%= query.dimension_header %></th>
          <th scope="col"><%= query.measure_header %></th>
          <% query.companion_columns.each do |column| %>
            <%= tag.th column.header, scope: "col", class: ("janela-fact" if column.fact) %>
          <% end %>
        </tr>
      </thead>
    <% end %>
    <tbody>
      <% result.each do |label, measured| %>
        <% click = query.click_data(label) if query.clickable? %>
        <tr>
          <td>
            <% if click %>
              <%= tag.button label, type: "button", aria: { pressed: query.selected?(label) },
                    data: { action: "janela--frame#toggle" }.merge(click) %>
            <% else %>
              <span><%= label %></span>
            <% end %>
          </td>
          <td><%= query.format(measured) %></td>
          <% query.companion_columns.each do |column| %>
            <%= tag.td column.cells[label], class: ("janela-fact" if column.fact) %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  <% end %>
  <%# A ring cannot draw a negative part or a total of nothing, so it says it
      is a table rather than drawing something wrong (ADR 046). %>
  <% if query.ring? %>
    <p class="janela-muted"><%= t("janela.rings.not_drawable") %></p>
  <% end %>
<% end %>
