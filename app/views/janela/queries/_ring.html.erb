<%# A doughnut or a pie, drawn here rather than on a canvas so it is in the
    HTML before any JavaScript runs, prints, and can be read and operated by
    a keyboard through the legend (ADR 046, ADR 026). A slice and its legend
    row toggle the same filter, and the legend is the control a keyboard and a
    screen reader use, so the slices are not offered to them twice. %>
<% title_id = "#{query.turbo_frame_id}-title" %>
<% slices = query.slices(result) %>
<% selecting = slices.any?(&:selected) %>
<figure class="janela-pane janela-ring">
  <figcaption class="janela-chart-title" id="<%= title_id %>"><%= query.title %></figcaption>
  <svg class="janela-ring-svg" viewBox="0 0 100 100" role="img" aria-labelledby="<%= title_id %>"
       data-hole="<%= query.hole? %>">
    <% slices.each do |slice| %>
      <% path = slice.path(hole: query.hole?) %>
      <% next unless path %>
      <%= tag.path d: path, class: [ "janela-ring-slice", ("janela-dim" if selecting && !slice.selected) ],
            style: "fill: var(#{slice.property})",
            data: (slice.click ? { action: "click->janela--frame#toggle" }.merge(slice.click) : {}) do %>
        <title><%= slice.label %>: <%= slice.formatted %></title>
      <% end %>
    <% end %>
  </svg>
  <table class="janela-legend">
    <tbody>
      <% slices.each do |slice| %>
        <tr>
          <td>
            <span class="janela-swatch" style="background: var(<%= slice.property %>)" aria-hidden="true"></span>
            <% if slice.click %>
              <%= tag.button slice.label, type: "button", aria: { pressed: slice.selected },
                    data: { action: "janela--frame#toggle" }.merge(slice.click) %>
            <% else %>
              <span><%= slice.label %></span>
            <% end %>
          </td>
          <td><%= slice.formatted %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</figure>
