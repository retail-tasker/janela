<% content_for :title, t(".title") %>
<% content_for :translated, true %>
<% content_for :description, t(".description") %>
<header class="demo-header">
  <h1><%= t(".h1") %></h1>
  <p>
    <%= t(".intro") %>
    <% if @snapshot %>
      <%= t(".snapshot_html", link: link_to(@snapshot.name, snapshot_path(@snapshot))) %>
    <% end %>
    <% if @frame %>
      <%= t(".frame_html", link: link_to(@frame.name.downcase, frame_path(@frame))) %>
    <% end %>
  </p>
</header>

<%= janela_frame where: @fixed do %>
  <div class="demo-toolbar">
    <button type="button" class="vitral-button" data-action="janela--frame#clear"><%= t(".clear") %></button>
  </div>

  <section class="demo-grid vitral-panes">
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :orders, prominence: 3 %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :average_order, prominence: 1 %></div>
    <div class="demo-tile demo-wide"><%= janela_pane Order, :revenue, by: :placed_on, as: :line, granularity: :month, height: 3 %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :status, as: :bar %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :expedited_rate, by: :channel, as: :bar, value_labels: true %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :region %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :customer, limit: 5, companions: [ :orders, :region ] %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :orders, by: :region %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :orders, by: :channel %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :orders, by: :customer, limit: 5, sort: :asc %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :status, id: "orders-revenue-by-status" %></div>
  </section>
<% end %>
