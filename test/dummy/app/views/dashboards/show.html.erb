<header class="demo-header">
  <h1>Orders</h1>
  <p>
    A live Janela dashboard over a year of demo orders. Click any value to cross-filter the rest;
    click it again to clear. Hold Ctrl, or Cmd on a Mac, to select more than one value in a dimension,
    and press Escape to clear the lot. Time panes re-scope but are not clickable yet. Filters live in
    the URL, so reload or share it.
    <% if @snapshot %>
      The <%= link_to @snapshot.name, snapshot_path(@snapshot) %> snapshot shows the same panes frozen.
    <% end %>
    <% if @frame %>
      The panes on this page are written by hand;
      <%= link_to @frame.name.downcase, frame_path(@frame) %> is the same dashboard built from rows.
    <% end %>
  </p>
</header>

<%= janela_frame do %>
  <div class="demo-toolbar">
    <button type="button" class="vitral-button" data-action="janela--frame#clear">Clear filters</button>
  </div>

  <section class="demo-grid vitral-panes">
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :orders %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :average_order %></div>
    <div class="demo-tile demo-wide"><%= janela_pane Order, :revenue, by: :placed_on, as: :line, granularity: :month %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :status, as: :bar %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :region %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :customer, limit: 5 %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :orders, by: :region %></div>
    <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :status, id: "orders-revenue-by-status" %></div>
  </section>
<% end %>
