<% content_for :title, "Gallery" %>

<%# One line of prose per renderer, keyed the same way sections and the
    sidebar are: what a reader is looking for when they come here, not what
    the query underneath does. %>
<% renderer_leads = {
  "table" => "Every row a query returns, as it is. Nothing else is drawn without a
              measure, so this is the one renderer every model can demonstrate.",
  "bar" => "A measure compared across a categorical dimension: one bar per value,
            the shape for ranking or comparing a handful of groups.",
  "line" => "A measure tracked over a time dimension, bucketed by whatever
             granularity that dimension offers.",
  "doughnut" => "A measure split across a categorical dimension as parts of a whole. Drawn
                 as SVG with a legend of buttons, so it reads without JavaScript and every
                 slice can be reached from the keyboard.",
  "pie" => "The same split as a doughnut, without the hole. Best with a handful of values:
            past eight, the rest share one neutral colour.",
} %>

<%= render layout: "shared/shell" do %>
  <header class="gallery-header">
    <p class="eyebrow">Reference</p>
    <h1>Gallery</h1>
    <p>
      Every renderer Janela ships (<%= Janela.renderers.to_sentence %>), drawn live against this demo's own
      data, with the declaration that produced it beside it. Built from nothing but <code>janela_pane</code>
      and what Janela exposes for exactly this: a time dimension can bucket by
      <%= Janela.granularities.to_sentence %>, and a form offers <%= Janela.offered_limits.join(", ") %> as a
      row limit. Beside each pane is a control for every other option a pane takes: a chart's height
      (<%= Janela.heights.first %> to <%= Janela.heights.last %>), whether a bar shows its value, how prominent a
      single value is (<%= Janela.prominences.first %> to <%= Janela.prominences.last %>), and up to <%= Janela.max_companions %>
      companion columns on a table. Each appears only while the renderer chosen is one it changes, and the
      declaration rewrites itself to match, so it can be copied. This is a host page built from the gem's helpers, not one of the engine's own (<%= adr_link 27 %>).
    </p>
  </header>

  <% if @definitions.empty? %>
    <p class="janela-empty">
      No model here declares a <code>janela</code> block yet, so there is nothing to draw. Add one, for
      example <code>janela { measure :total, sum: :amount }</code>, and this page draws it next time it loads.
    </p>
  <% else %>
    <%# Wrapped in the frame controller like any other page of panes, even
        though nothing here cross-filters anything else: it is what makes a
        lazily loaded pane's readiness visible to the test suite's own wait,
        and it is what a host building this page from the README's dashboard
        example would already have reached for. %>
    <%= janela_frame do %>
      <% @galleries.each do |renderer, entries| %>
        <section class="gallery-section" id="gallery-<%= renderer %>">
          <h2><%= t("janela.renderers.#{renderer}") %></h2>
          <p class="lede"><%= renderer_leads[renderer] %></p>

          <% entries.each do |entry| %>
            <%# A single-value entry has no dimension, and Definition#query
                ignores renderer, granularity and limit alike when there is
                none to group by, so those three are not offered for it (#40).
                What changes a single value is how prominent it is, so that is
                its one control. %>
            <% configurable = entry.available? %>
            <%# Unique per section and model, since one model can appear in more
                than one renderer section, and a section holds an entry per
                model: Order and its wholesale subclass are both definitions
                and both draw here (ADR 031). %>
            <% dom_id = "gallery-#{renderer}-#{entry.model.model_name.route_key}" %>
            <%# The pane's own URL, without the renderer, granularity or limit
                the form below chooses and without any filters, which are the
                frame's to write (ADR 030). A host knows its panes' addresses
                because it declared them. %>
            <%= tag.article id: "#{dom_id}-entry", class: "gallery-entry", data: (configurable ? {
                  controller: "gallery-config",
                  gallery_config_model_value: entry.model.name,
                  gallery_config_measure_value: entry.measure,
                  gallery_config_dimension_value: entry.dimension,
                  gallery_config_max_companions_value: Janela.max_companions,
                  gallery_config_path_value: janela.pane_path(entry.model.model_name.route_key, entry.measure, entry.dimension),
                } : {}) do %>
              <h3><%= entry.model.model_name.human %></h3>

              <% if entry.available? %>
                <%# A configurable entry names its pane with the same id, so the
                    control below can change the query in place and Turbo still
                    has one frame to reconcile into (ADR 029). %>
                <div class="gallery-entry-grid">
                  <div class="gallery-visual vitral-pane">
                    <%= janela_pane entry.model, entry.measure, by: entry.dimension, as: entry.renderer, granularity: entry.granularity,
                          id: (dom_id if configurable) %>
                  </div>
                  <div class="gallery-code vitral-pane">
                    <p class="eyebrow">Declaration</p>
                    <code class="gallery-declaration"><%= entry.declaration %></code>

                    <% if configurable %>
                      <%# Hidden until the controller connects: with no JavaScript these
                          selects have nothing to do, so a reader is not shown a dead
                          control (#40). %>
                      <div class="janela-form gallery-config-form" hidden data-action="change->gallery-config#change">
                        <% if entry.single_value? %>
                          <div class="janela-field">
                            <%= label_tag "#{dom_id}-prominence", Janela::Pane.human_attribute_name(:prominence) %>
                            <%= select_tag "#{dom_id}-prominence",
                                  options_for_select([ [ t("janela.prominences.automatic"), "" ] ] + Janela.prominences.map { |step| [ t("janela.prominences.#{step}"), step ] }),
                                  name: "prominence" %>
                          </div>
                        <% else %>
                        <div class="janela-field">
                          <%= label_tag "#{dom_id}-renderer", Janela::Pane.human_attribute_name(:renderer) %>
                          <%= select_tag "#{dom_id}-renderer",
                                options_for_select(Janela.renderers.map { |value| [ t("janela.renderers.#{value}"), value ] }, entry.renderer),
                                name: "renderer" %>
                        </div>

                        <% if entry.time_dimension? %>
                          <div class="janela-field">
                            <%= label_tag "#{dom_id}-granularity", Janela::Pane.human_attribute_name(:granularity) %>
                            <%= select_tag "#{dom_id}-granularity",
                                  options_for_select(Janela.granularities.map { |value| [ value.humanize, value ] }, entry.granularity.to_s),
                                  name: "granularity" %>
                          </div>
                        <% else %>
                          <div class="janela-field">
                            <%= label_tag "#{dom_id}-limit", Janela::Pane.human_attribute_name(:limit) %>
                            <%= select_tag "#{dom_id}-limit",
                                  options_for_select([ [ t("janela.panes.no_limit"), "" ] ] + Janela.offered_limits.map { |value| [ value, value ] }),
                                  name: "limit" %>
                          </div>
                        <% end %>

                        <%# Each of these is shown only while the renderer chosen is one it
                            changes, so a reader is never offered a control that does nothing. %>
                        <div class="janela-field" data-renderers="bar line">
                          <%= label_tag "#{dom_id}-height", Janela::Pane.human_attribute_name(:height) %>
                          <%= select_tag "#{dom_id}-height",
                                options_for_select([ [ t("janela.heights.automatic"), "" ] ] + Janela.heights.map { |step| [ t("janela.heights.#{step}"), step ] }),
                                name: "height" %>
                        </div>

                        <div class="janela-field gallery-check" data-renderers="bar">
                          <%= check_box_tag "#{dom_id}-value-labels", "1", false, name: "value_labels" %>
                          <%= label_tag "#{dom_id}-value-labels", Janela::Pane.human_attribute_name(:value_labels) %>
                        </div>

                        <% if entry.companion_choices.present? %>
                          <fieldset class="janela-field gallery-companions" data-renderers="table">
                            <legend><%= Janela::Pane.human_attribute_name(:companions) %></legend>
                            <% entry.companion_choices.each do |name| %>
                              <span class="gallery-check">
                                <%= check_box_tag "#{dom_id}-companion-#{name}", name, false, name: "companions[]" %>
                                <%= label_tag "#{dom_id}-companion-#{name}", name.to_s.humanize %>
                              </span>
                            <% end %>
                            <span class="janela-hint"><%= t("janela.companions.hint") %></span>
                          </fieldset>
                        <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% else %>
                <p class="janela-muted">Not shown: <%= entry.reason %>.</p>
              <% end %>
            <% end %>
          <% end %>
        </section>
      <% end %>
    <% end %>
  <% end %>
<% end %>
