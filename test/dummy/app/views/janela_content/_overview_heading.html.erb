<%# A host's own content partial (ADR 039): the host draws the icon and the
    layout, and the analyst's row supplies the words, which arrive as plain
    strings and are escaped like any other. %>
<div class="demo-overview-heading">
  <svg aria-hidden="true" viewBox="0 0 32 32" width="28" height="28">
    <path d="M5 15a11 11 0 0 1 22 0v11a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z" fill="none" stroke="currentColor" stroke-width="2"/>
    <path d="M16 4v25M5.5 13h21M5 23h22" stroke="currentColor" stroke-width="1.4"/>
  </svg>
  <h2><%= heading %></h2>
  <% if body.present? %><p><%= body %></p><% end %>
</div>
