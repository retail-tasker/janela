<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Janela dummy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3CclipPath id='w'%3E%3Cpath d='M5 15a11 11 0 0 1 22 0v11a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z'/%3E%3C/clipPath%3E%3Cg clip-path='url(%23w)'%3E%3Cpath d='M0 0h17v13H0z' fill='%233a7aeb'/%3E%3Cpath d='M17 0h15v13H17z' fill='%231ca89e'/%3E%3Cpath d='M0 13h17v10H0z' fill='%238a6ee4'/%3E%3Cpath d='M17 13h15v10H17z' fill='%23f0b046'/%3E%3Cpath d='M0 23h32v9H0z' fill='%23e06082'/%3E%3C/g%3E%3Cg stroke='%231a2636' fill='none'%3E%3Cpath d='M5 15a11 11 0 0 1 22 0v11a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z' stroke-width='2.4'/%3E%3Cpath d='M16 4v25M5.5 13h21M5 23h22' stroke-width='1.8'/%3E%3C/g%3E%3C/svg%3E">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "janela" %>
    <%= stylesheet_link_tag "vitral" %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="vitral" data-controller="vitral">
    <%# A route helper here on purpose: it is what almost every real host has,
        and what broke panes before ADR 011. %>
    <nav>
      <%= link_to root_path, class: "brand" do %>
        <%= render "shared/logo" %><span>Janela</span>
      <% end %>
      <%= link_to "Orders", orders_path %>
      <%= link_to "Janela's own index", janela.frames_path %>
    </nav>
    <%= yield %>
  </body>
</html>
