<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Janela dummy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%# A route helper here on purpose: it is what almost every real host has,
        and what broke panes before ADR 011. %>
    <nav><%= link_to "Orders", root_path %></nav>
    <%= yield %>
  </body>
</html>
