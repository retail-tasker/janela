<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Janela dummy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3CclipPath id='w'%3E%3Cpath d='M5 15a11 11 0 0 1 22 0v11a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z'/%3E%3C/clipPath%3E%3Cg clip-path='url(%23w)'%3E%3Cpath d='M0 0h17v13H0z' fill='%233a7aeb'/%3E%3Cpath d='M17 0h15v13H17z' fill='%231ca89e'/%3E%3Cpath d='M0 13h17v10H0z' fill='%238a6ee4'/%3E%3Cpath d='M17 13h15v10H17z' fill='%23f0b046'/%3E%3Cpath d='M0 23h32v9H0z' fill='%23e06082'/%3E%3C/g%3E%3Cg stroke='%231a2636' fill='none'%3E%3Cpath d='M5 15a11 11 0 0 1 22 0v11a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z' stroke-width='1.5'/%3E%3Cpath d='M16 4v25M5.5 13h21M5 23h22' stroke-width='0.9'/%3E%3C/g%3E%3C/svg%3E">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "janela" %>
    <%= stylesheet_link_tag "vitral" %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="vitral" data-controller="vitral">
    <%# A route helper here on purpose: it is what almost every real host has,
        and what broke panes before ADR 011. %>
    <% nav_links = capture do %>
      <%= link_to "Documentation", docs_path %>
      <%= link_to "Example", orders_path %>
      <%= link_to "Gallery", gallery_path %>
      <%= link_to "Dashboards", janela.frames_path %>
      <%= link_to "The name", the_name_path %>
    <% end %>
    <nav>
      <%= link_to root_path, class: "brand" do %>
        <%= render "shared/logo" %><span>Janela</span>
      <% end %>
      <div class="nav-links-wide"><%= nav_links %></div>
      <%# A phone gets the same links again, behind a hamburger, rather than
          the wide row unwrapped: a closed details' content is hidden in a way
          no CSS on this element can undo, so the wide row has to be its own
          element instead of a shown/hidden state of this one. %>
      <details class="nav-menu" data-controller="nav-menu">
        <summary class="nav-toggle" aria-label="Menu"></summary>
        <div class="nav-links"><%= nav_links %></div>
      </details>
    </nav>
    <%# Janela's own pages carry no notion of this site's gutters (the gem
        cannot know a host's class names), so the one wrapping div they need
        lives here instead, reusing the site's existing container rule rather
        than a padding value invented just for them. %>
    <% if controller.is_a?(Janela::ApplicationController) %>
      <div class="frame-page"><%= yield %></div>
    <% else %>
      <%= yield %>
    <% end %>
    <%# The gallery and the documentation pages share a sidebar running the
        full height of their content column (Tailwind's own docs are the
        model again), so their footer sits inside that column, next to the
        sidebar, rather than full width below it like every other page's.
        shared/_shell renders it for them. %>
    <%= render "shared/footer" unless %w[gallery docs].include?(controller_name) %>
  </body>
</html>
