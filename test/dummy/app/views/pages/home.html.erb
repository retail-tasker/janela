<% content_for :title, t(".title") %>
<% content_for :description, t(".description") %>
<% content_for :translated, true %>

<section class="hero">
  <span class="hero-mark-wrap" data-controller="fan" data-action="mouseenter->fan#shuffle"><%= render "shared/logo", size: 150, class_name: "hero-mark" %></span>
  <p class="name-word">ja·ne·la</p>
  <p class="name-gloss"><%= t(".gloss_html") %></p>
  <h1><%= t(".h1") %></h1>
  <p class="hero-sub">
    <%= t(".hero_sub") %>
  </p>
  <p class="hero-actions">
    <%= link_to t(".open_dashboard"), orders_path, class: "button button-primary" %>
    <%= link_to t(".read_source"), "https://github.com/retail-tasker/janela", class: "button" %>
  </p>
  <div class="install" data-controller="clipboard"
       data-clipboard-text-value='gem "janela", "~> <%= Janela::VERSION.split(".").first(2).join(".") %>"'>
    <code class="install-line">gem "janela", "~&gt; <%= Janela::VERSION.split(".").first(2).join(".") %>"</code>
    <button type="button" class="install-copy" data-action="clipboard#copy" data-clipboard-target="button">
      <%= t(".copy") %>
    </button>
  </div>
  <p class="hero-note"><%= t(".hero_note", version: Janela::VERSION) %></p>
</section>

<section class="live">
  <h2><%= t(".live_h2") %></h2>
  <p class="lede">
    <%= t(".live_lede") %>
  </p>

  <%# Janela leaves a button to the host: this is the demo's own, wired to the
      frame's clear action, and only shown while something is selected. %>
  <%= tag.p class: "hero-actions", data: { controller: "clear" }, hidden: params[:q].blank? do %>
    <button type="button" class="button" data-action="clear#clear"><%= t(".clear") %></button>
    <span class="hero-note"><%= t(".clear_note") %></span>
  <% end %>

  <% if @frame %>
    <div class="demo-frame"><%= janela_frame @frame %></div>
    <p class="lede">
      <%= t(".edit_html", edit: link_to(t(".edit_link"), janela.edit_frame_path(@frame))) %>
    </p>
  <% else %>
    <%= janela_frame do %>
      <section class="demo-grid demo-grid-4">
        <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue %></div>
        <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :status, as: :bar %></div>
        <div class="demo-tile vitral-pane"><%= janela_pane Order, :revenue, by: :region %></div>
        <div class="demo-tile vitral-pane"><%= janela_pane Order, :orders, by: :status, as: :doughnut %></div>
        <div class="demo-tile vitral-pane demo-wide"><%= janela_pane Order, :revenue, by: :placed_on, as: :line, granularity: :week %></div>
      </section>
    <% end %>
  <% end %>

  <p class="lede">
    <%= t(".more_html", full: link_to(t(".more_full"), orders_path), own: link_to(t(".more_own"), janela.frames_path)) %>
  </p>
</section>

<section class="why">
  <h2><%= t(".why_h2") %></h2>
  <p class="lede"><%= t(".why_lede") %></p>
  <ul class="reasons">
    <li>
      <%= t(".why_sql_html") %>
    </li>
    <li>
      <%= t(".why_admin_html") %>
    </li>
  </ul>
  <p class="lede">
    <%= t(".why_close") %>
  </p>
</section>

<section class="features">
  <h2><%= t(".features_h2") %></h2>
  <div class="cards vitral-panes">
    <div class="card vitral-pane">
      <h3><%= t(".f1_title") %></h3>
      <p><%= t(".f1_body") %></p>
    </div>
    <div class="card vitral-pane">
      <h3><%= t(".f2_title") %></h3>
      <p><%= t(".f2_body") %></p>
    </div>
    <div class="card vitral-pane">
      <h3><%= t(".f3_title") %></h3>
      <p><%= t(".f3_body_html") %></p>
    </div>
    <div class="card vitral-pane">
      <h3><%= t(".f4_title") %></h3>
      <p><%= t(".f4_body") %></p>
    </div>
    <div class="card vitral-pane">
      <h3><%= t(".f5_title") %></h3>
      <p><%= t(".f5_body") %></p>
    </div>
    <div class="card vitral-pane">
      <h3><%= t(".f6_title") %></h3>
      <p><%= t(".f6_body_html") %></p>
    </div>
  </div>
</section>

<section class="code">
  <h2><%= t(".code_h2") %></h2>
  <p class="lede"><%= t(".code_lede") %></p>

  <pre><code><span class="t-k">class</span> <span class="t-c">Order</span> &lt; <span class="t-c">ApplicationRecord</span>
  <span class="t-m">belongs_to</span> <span class="t-s">:customer</span>

  <span class="t-m">janela</span> <span class="t-k">do</span>
    <span class="t-m">measure</span> <span class="t-s">:revenue</span>, <span class="t-l">sum:</span> <span class="t-s">:amount</span>, <span class="t-l">prefix:</span> <span class="t-str">&quot;$&quot;</span>
    <span class="t-m">measure</span> <span class="t-s">:orders</span>, <span class="t-l">count:</span> <span class="t-k">true</span>

    <span class="t-m">dimension</span> <span class="t-s">:status</span>
    <span class="t-m">dimension</span> <span class="t-s">:region</span>, <span class="t-l">through:</span> <span class="t-s">:customer</span>
    <span class="t-m">dimension</span> <span class="t-s">:placed_on</span>, <span class="t-l">granularity:</span> <span class="t-s">:month</span>
  <span class="t-k">end</span>
<span class="t-k">end</span></code></pre>

  <pre><code><span class="t-e">&lt;%=</span> <span class="t-m">janela_frame</span> <span class="t-k">do</span> <span class="t-e">%&gt;</span>
  <span class="t-e">&lt;%=</span> <span class="t-m">janela_pane</span> <span class="t-c">Order</span>, <span class="t-s">:revenue</span> <span class="t-e">%&gt;</span>
  <span class="t-e">&lt;%=</span> <span class="t-m">janela_pane</span> <span class="t-c">Order</span>, <span class="t-s">:revenue</span>, <span class="t-l">by:</span> <span class="t-s">:status</span>, <span class="t-l">as:</span> <span class="t-s">:bar</span> <span class="t-e">%&gt;</span>
  <span class="t-e">&lt;%=</span> <span class="t-m">janela_pane</span> <span class="t-c">Order</span>, <span class="t-s">:revenue</span>, <span class="t-l">by:</span> <span class="t-s">:region</span> <span class="t-e">%&gt;</span>
<span class="t-e">&lt;%</span> <span class="t-k">end</span> <span class="t-e">%&gt;</span></code></pre>

  <p class="lede">
    <%= t(".code_close") %>
  </p>
</section>

<section class="fork">
  <h2><%= t(".fork_h2") %></h2>
  <p class="lede">
    <%= t(".fork_lede") %>
  </p>
  <p class="hero-actions">
    <%= link_to t(".fork_source"), "https://github.com/retail-tasker/janela", class: "button button-primary" %>
    <%= link_to t(".fork_decisions"), "https://github.com/retail-tasker/janela/blob/main/docs/decisions/INDEX.md", class: "button" %>
  </p>
</section>

