  <div class="qa-grid vitral-panes">

  <div class="qa vitral-pane">
    <h3><%= t(".q1_q") %></h3>
    <p><%= t(".q1_a") %></p>
  </div>

  <div class="qa vitral-pane">
    <h3><%= t(".q2_q") %></h3>
    <p><%= t(".q2_a_html") %></p>
  </div>

  <div class="qa vitral-pane">
    <h3><%= t(".q3_q") %></h3>
    <p><%= t(".q3_a") %></p>
  </div>

  <div class="qa vitral-pane">
    <h3><%= t(".q4_q") %></h3>
    <p><%= t(".q4_a") %></p>
  </div>

  <div class="qa vitral-pane">
    <h3><%= t(".q5_q") %></h3>
    <p><%= t(".q5_a_html", version: Janela::VERSION) %></p>
  </div>

  <div class="qa vitral-pane">
    <h3><%= t(".q6_q") %></h3>
    <p><%= t(".q6_a") %></p>
  </div>
  </div>
</section>
