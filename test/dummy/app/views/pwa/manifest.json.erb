{
  "id": "/",
  "name": "Janela",
  "short_name": "Janela",
  "description": "Cross-filtering dashboards, native to Rails.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#f4f7fb",
  "background_color": "#e3eaf3",
  "icons": [
    { "src": "<%= image_path "pwa/icon-192.png" %>", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "<%= image_path "pwa/icon-512.png" %>", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "<%= image_path "pwa/icon-maskable-192.png" %>", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "<%= image_path "pwa/icon-maskable-512.png" %>", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "<%= image_path "pwa/screenshot-wide.png" %>", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "An orders dashboard, cross-filtered" },
    { "src": "<%= image_path "pwa/screenshot-narrow.png" %>", "sizes": "412x915", "type": "image/png", "form_factor": "narrow", "label": "The same dashboard on a phone" }
  ]
}
