<%# Full width on purpose: the bottom pane of the window, with the five glass
    colours as its leading and the same light falling across it. %>
<footer class="site-footer" id="site-footer">
  <div class="site-footer-inner">
    <div class="footer-brand">
      <%= render "shared/logo", size: 92, class_name: "footer-mark" %>
      <div>
        <p class="footer-name">Janela</p>
        <p class="footer-tag">
          <%= t(".tag_html") %>
        </p>
      </div>
    </div>

    <%# The gem's downloads and the repository's stars, from the source and
        cached (ADR 060). Missing when a service is down: the links stay. %>
    <% stats = ProjectStats.current %>
    <div class="footer-links">
      <div>
        <h2><%= t(".project") %></h2>
        <% if stats.any? %>
          <p class="footer-stats">
            <% if stats[:stars] %><a class="footer-stat footer-stat-stars" href="https://github.com/retail-tasker/janela/stargazers"><%= t(".stars", count: stats[:stars], number: number_with_delimiter(stats[:stars])) %></a><% end %>
            <% if stats[:downloads] %><a class="footer-stat footer-stat-downloads" href="https://rubygems.org/gems/janela"><%= t(".downloads", count: stats[:downloads], number: number_with_delimiter(stats[:downloads])) %></a><% end %>
          </p>
        <% end %>
        <ul>
          <li><a href="https://github.com/retail-tasker/janela"><%= t(".github") %></a></li>
          <li><a href="https://rubygems.org/gems/janela"><%= t(".gem") %></a></li>
          <li><a href="https://github.com/retail-tasker/janela/issues"><%= t(".open_work") %></a></li>
        </ul>
      </div>
      <div>
        <h2><%= t(".why") %></h2>
        <ul>
          <li><a href="https://github.com/retail-tasker/janela/blob/main/docs/decisions/INDEX.md"><%= t(".decisions") %></a></li>
          <li><a href="https://github.com/retail-tasker/janela/blob/main/docs/multi-tenancy.md"><%= t(".tenancy") %></a></li>
          <li><a href="https://github.com/retail-tasker/janela/blob/main/CHANGELOG.md"><%= t(".changes") %></a></li>
        </ul>
      </div>
      <div>
        <h2><%= t(".demo") %></h2>
        <ul>
          <li><%= link_to t(".full"), orders_path %></li>
          <li><%= link_to t(".frames"), janela.frames_path %></li>
          <li><%= link_to t(".start_over"), root_path %></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-people">
    <h2><%= t(".built_by") %></h2>
    <ul>
      <li>
        <%# Gravatar for the project address, falling back to the GitHub
            picture, so a gravatar registered later just appears. %>
        <a href="https://github.com/jaykilleen">
          <img class="person-mark person-photo" src="https://www.gravatar.com/avatar/8cdbfd6e1b7c55a7499271a500ccd0141ce2b3419940cb86ca0c8a0cdb96b509?s=96&d=https%3A%2F%2Favatars.githubusercontent.com%2Fu%2F4168099%3Fv%3D4%26s%3D96" alt="" width="30" height="30" loading="lazy">
          Jay Killeen
        </a>
      </li>
      <li>
        <a href="https://github.com/rsvanessasoaresss">
          <span class="person-mark">VS</span>
          Vanessa Soares
        </a>
      </li>
      <li>
        <a href="https://www.anthropic.com/claude">
          <span class="person-mark person-ai">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4"/>
              </g>
            </svg>
          </span>
          Claude
        </a>
      </li>
    </ul>
    <p class="footer-note">
      <%= t(".note") %>
    </p>
  </div>

  <div class="footer-fine">
    <p>
      <%= t(".fine", version: Janela::VERSION) %>
    </p>
    <%# The 37signals pattern: the makers named by the software they ship, so
        the logo is proof that this runs in production rather than a badge. %>
    <div class="footer-makers">
      <span><%= t(".makers") %></span>
      <a href="https://winontheshelf.com"><%= image_tag "win-on-the-shelf.png", alt: "Win on the Shelf" %></a>
      <span class="footer-copyright">&copy; <%= Date.current.year %> <a href="https://www.retailtasker.com.au">Retail Tasker</a></span>
    </div>
  </div>
</footer>
