#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
  export LD_PRELOAD
fi

# Create or migrate the database, then seed. db:prepare only seeds a database
# it created itself, so on a persistent volume a newly added seed would never
# run. The demo's seeds guard each section, so running them every boot adds
# what is new and leaves the rest alone.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare db:seed
fi

exec "${@}"
